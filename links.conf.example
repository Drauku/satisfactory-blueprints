# Maps a Satisfactory session to a blueprint folder in this repo.
#   <session name> = <repo folder>
# The session name must match the save's session exactly, including spaces.
# Several sessions may share one folder; the library is then stored once.
#
# Copy to links.conf and edit. links.conf is local and not tracked by git.
# Run ./link-blueprints.sh --list to see the sessions found in your saves.

My First World  = _master
Another World   = _master
